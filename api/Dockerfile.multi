FROM node:20-slim AS build
WORKDIR /app

COPY package*.json ./
RUN --mount=type=secret,id=build_secret,target=/run/secrets/build_secret \
  test -s /run/secrets/build_secret && npm ci --omit=dev

COPY server.js db.js ./

FROM node:20-slim AS runtime
WORKDIR /app

RUN apt-get update \
  && apt-get upgrade -y \
  && rm -rf /var/lib/apt/lists/* \
  && rm -rf /usr/local/lib/node_modules/npm \
  && rm -f /usr/local/bin/npm /usr/local/bin/npx /usr/local/bin/corepack

COPY --from=build --chown=node:node /app/package*.json ./
COPY --from=build --chown=node:node /app/node_modules ./node_modules
COPY --from=build --chown=node:node /app/server.js /app/db.js ./

USER node

CMD ["node", "server.js"]

EXPOSE 3000

HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
  CMD node -e "fetch('http://localhost:3000/health').then(r => process.exit(r.ok ? 0 : 1)).catch(() => process.exit(1))" || exit 1
